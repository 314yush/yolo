# Optional: Avantis feed-v3 URL for browser SSE + chart history (default: https://feed-v3.avantisfi.com)
# NEXT_PUBLIC_AVANTIS_FEED_V3_URL=https://feed-v3.avantisfi.com

# Avantis v2 (intent + batched-market) on Base mainnet is the only supported
# path — no enable flag and no testnet switch. See src/lib/avantisV2/README.md.


# Backend API URL (server-side only — used by /api/backend proxy)
# Set to your FastAPI backend URL. For Vercel, use your Railway backend URL.
BACKEND_URL=http://localhost:8000

# Local development: Privy must allow this origin (Dashboard → App → URLs).
# Visit http://localhost:3000/api/proxy-status for a config checklist.

# Optional: skip access-code gate while developing (do not enable in production).
# NEXT_PUBLIC_BYPASS_ACCESS_CODE=true

# Required in production. Alchemy Base mainnet preferred (rate limits + reliability).
# Public Base RPC (https://mainnet.base.org) is a last-resort fallback only —
# allowance reads and setup checks will flake under load.
# Get a key at https://dashboard.alchemy.com/
NEXT_PUBLIC_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Required: Privy App ID — https://privy.io/
#
# Dashboard (App settings) — both are required for v2:
#   1. Embedded wallets → turn OFF confirmation / wallet UIs.
#      Every trade is a silent EIP-712 sign on the embedded wallet. If these
#      UIs stay on, every spin opens a modal and the wheel UX breaks.
#   2. Gas sponsorship → enable on Base.
#      The one-time USDC approve (TradingStorage) is Privy-sponsored. Users
#      never hold ETH. Trades themselves are gasless via the Avantis relayer.
#
# There is no TACHYON key and no Avantis API/delegate key.
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# Avantis Pusher: public app key/cluster are hardcoded in lib/pusherClient.ts (optional env override not wired).
