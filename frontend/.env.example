# Optional: Avantis feed-v3 URL for browser SSE + chart history (default: https://feed-v3.avantisfi.com)
# NEXT_PUBLIC_AVANTIS_FEED_V3_URL=https://feed-v3.avantisfi.com

# Backend API URL (server-side only — used by /api/backend proxy)
# Set to your FastAPI backend URL. For Vercel, use your Railway backend URL.
BACKEND_URL=http://localhost:8000

# Required: Your Alchemy API key for Base mainnet
# Get your key at https://dashboard.alchemy.com/
NEXT_PUBLIC_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Required: Your Privy App ID
# Get your App ID at https://privy.io/
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# Required: Tachyon API key for gas sponsorship
# Get your API key at https://rath.fi
NEXT_PUBLIC_TACHYON_API_KEY=your_tachyon_api_key

# Avantis Pusher: public app key/cluster are hardcoded in lib/pusherClient.ts (optional env override not wired).
