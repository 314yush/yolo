# Deployment environment: production | development | test
# Defaults to production. In production the app refuses to start without
# DATABASE_URL, with DEBUG=true, or with a wildcard CORS_ORIGINS.
ENVIRONMENT=development

# Required: Alchemy (or other) Base mainnet RPC URL
# Get your key at https://dashboard.alchemy.com/
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Required in production: PostgreSQL connection string (Railway provides this).
# Must start with postgres:// or postgresql:// - anything else is a startup error.
DATABASE_URL=postgresql://user:password@host:5432/railway

# CORS allowlist. Comma-separated or JSON array.
# Defaults to https://tradeyolo.fun + https://www.tradeyolo.fun in production,
# localhost in development.
# "*" is rejected in production.
CORS_ORIGINS=http://localhost:3000

# Debug mode exposes /docs and /redoc. Rejected when ENVIRONMENT=production.
DEBUG=false

# Optional rate-limit tuning (defaults shown)
# RATE_LIMIT_DEFAULT=240/minute
# RATE_LIMIT_WRITE=30/minute
# WALLET_RATE_LIMIT_MAX=60
# WALLET_RATE_LIMIT_WINDOW_SECONDS=60
# MAX_REQUEST_BODY_BYTES=16384
