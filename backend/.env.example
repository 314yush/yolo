# Required: Your Alchemy API key for Base mainnet
# Get your key at https://dashboard.alchemy.com/
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Optional: CORS origins (defaults to ["*"] for development)
CORS_ORIGINS=["http://localhost:3000"]

# Optional: Debug mode (defaults to false)
DEBUG=false

# Database: PostgreSQL connection string (Railway provides this)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Admin API key for generating access codes
ADMIN_API_KEY=your-secret-admin-key
